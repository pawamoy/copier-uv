{% raw %}{% extends "base.html" %}{% endraw %}

{% raw %}{% block outdated %}{% endraw %}
  {% raw %}{# Mike appends the deployed version to site_url. #}{% endraw %}
  {% raw %}{% if config.site_url[-4:] == "/dev" or config.site_url[-5:] == "/dev/" %}{% endraw %}
    You are viewing documentation for an <strong>unreleased version</strong>.
  {% raw %}{% else %}{% endraw %}
    You are not viewing documentation for the <strong>latest stable release</strong>.
  {% raw %}{% endif %}{% endraw %}
  {% raw %}<a href="{{ '../' ~ base_url }}"><strong>Go to the latest release.</strong></a>{% endraw %}
{% raw %}{% endblock %}{% endraw %}
{% if author_username == "pawamoy" %}
{% raw %}{% block announce %}{% endraw %}
  <strong>Fund this project</strong> through
  <a href="https://github.com/sponsors/pawamoy"><strong>sponsorship</strong></a>
  <span class="twemoji heart pulse">
    {% raw %}{% include ".icons/octicons/heart-fill-16.svg" %}{% endraw %}
  </span> &mdash;
  Follow
  <strong>@pawamoy</strong> on
  <a rel="me" href="https://fosstodon.org/@pawamoy">
    <span class="twemoji mastodon">
      {% raw %}{% include ".icons/fontawesome/brands/mastodon.svg" %}{% endraw %}
    </span>
    <strong>Fosstodon</strong>
  </a>
  for updates
{% raw %}{% endblock %}{% endraw %}
{% endif -%}
